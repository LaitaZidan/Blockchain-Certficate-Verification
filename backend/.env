# Sprint 3 (B8 local signing): private key of the Ganache dev account used as
# the transaction sender (must match web3.eth.accounts[0] on your local
# Ganache instance). Get it from the Ganache UI/CLI account list. Development
# key for a local instamine node only - never a real/funded account.
SENDER_PRIVATE_KEY= 0x319e4fe557219bdfbe5ee0a7afec94a11bd6c9fee94f2d27f0175bfc939f9b51

# Sprint 3 (B6): receipt polling interval in seconds, tuned for a local
# instamine node (which mines almost immediately).
RECEIPT_POLL_LATENCY=0.05

# Sprint 3 (B-read/V12): Redis cache for on-chain signature reads. Defaults to
# the same Redis instance as CELERY_BROKER_URL if left unset.
REDIS_URL=redis://localhost:6379/0

